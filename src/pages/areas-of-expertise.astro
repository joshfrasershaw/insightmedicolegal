---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import { expertise } from '../data/site';
---
<ContentPageLayout
  title="Types of reports | Insight Medicolegal"
  description="Psychiatric reports by Dr Yameen Qureshi for a range of legal and professional cases."
  heading="Types of reports"
  lead="The main areas Dr Qureshi works in."
  align="left"
>
  <div class="reports-grid">
    {expertise.map(item => (
      <a class="reports-card" href={`/${item.slug}`}>
        <div>
          <h2>{item.title}</h2>
          <p>{item.summary}</p>
        </div>
        <span class="reports-card__link">Read more <span aria-hidden="true">↗</span></span>
      </a>
    ))}
  </div>
  <p class="reports-note content-page-note">The scope of each instruction is considered individually. If your case is not listed, please get in touch with a brief outline before sending any medical records.</p>
</ContentPageLayout>
