---
import BaseLayout from '../layouts/BaseLayout.astro';
import { expertise } from '../data/site';
---
<BaseLayout title="Types of reports | Insight Medicolegal" description="Psychiatric reports by Dr Yameen Qureshi for a range of legal and professional cases.">
  <section class="inner-page">
    <div class="container">
      <header class="page-head">
        <h1>Types of reports</h1>
        <p class="page-lead">The main areas Dr Qureshi works in.</p>
      </header>
      <div class="expertise-overview">
        {expertise.map(item => <a class="overview-card" href={'/' + item.slug}>
          <h2>{item.title}</h2><p>{item.summary}</p><span>Read more ↗</span>
        </a>)}
      </div>
    </div>
  </section>
</BaseLayout>
