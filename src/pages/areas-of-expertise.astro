---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLetsTalk from '../components/HomeLetsTalk.astro';
import { expertise } from '../data/site';
---
<BaseLayout title="Types of reports | Insight Medicolegal" description="Psychiatric reports by Dr Yameen Qureshi for a range of legal and professional cases.">
  <section class="reports-hero" aria-labelledby="reports-page-title">
    <div class="container">
      <h1 id="reports-page-title">Types of reports</h1>
      <p>The main areas Dr Qureshi works in.</p>
    </div>
  </section>

  <section class="reports-content" aria-label="Types of psychiatric reports">
    <div class="container">
      <div class="reports-grid">
        {expertise.map(item => (
          <a class="reports-card" href={`/${item.slug}`}>
            <div>
              <h2>{item.title}</h2>
              <p>{item.summary}</p>
            </div>
            <span class="reports-card__link">Read more <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
      <p class="reports-note">The scope of each instruction is considered individually. If your case is not listed, please get in touch with a brief outline before sending any medical records.</p>
    </div>
  </section>

  <HomeLetsTalk />
</BaseLayout>

<style>
  .reports-hero {
    background:var(--navy);
    color:#fff;
    padding:clamp(165px,15vw,210px) 0 clamp(88px,8vw,120px);
  }
  .reports-hero h1 {
    max-width:950px;
    margin:0 0 23px;
    color:#fff;
    font:400 clamp(54px,6vw,86px)/1.1 var(--serif);
    letter-spacing:-.04em;
  }
  .reports-hero p {
    max-width:710px;
    margin:0;
    color:#dce8eb;
    font:400 clamp(16px,1.5vw,19px)/1.75 var(--sans);
  }
  .reports-content {
    padding:clamp(68px,6.5vw,100px) 0 clamp(78px,7vw,110px);
    background:var(--cream);
  }
  .reports-grid {
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:18px;
  }
  .reports-card {
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    gap:28px;
    min-height:265px;
    padding:clamp(22px,2.2vw,30px);
    background:#fff;
    border:1px solid var(--line);
    border-radius:5px;
    color:var(--ink);
    text-decoration:none;
    transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease;
  }
  .reports-card:hover {
    transform:translateY(-3px);
    border-color:#aabfc9;
    box-shadow:0 12px 24px rgba(16,37,46,.085);
    text-decoration:none;
  }
  .reports-card:focus-visible {
    outline:3px solid #71b0ff;
    outline-offset:4px;
  }
  .reports-card h2 {
    margin:0 0 14px;
    color:var(--navy);
    font:400 clamp(23px,2.1vw,29px)/1.2 var(--serif);
    letter-spacing:-.025em;
    overflow-wrap:break-word;
  }
  .reports-card p {
    margin:0;
    color:var(--slate);
    font:400 14px/1.65 var(--sans);
  }
  .reports-card__link {
    display:inline-block;
    color:var(--navy);
    font:700 13px/1.4 var(--sans);
  }
  .reports-card__link span {
    margin-left:3px;
    display:inline-block;
    transition:transform .2s ease;
  }
  .reports-card:hover .reports-card__link span {transform:translate(2px,-2px)}
  .reports-note {
    margin:24px 0 0;
    padding:19px 22px;
    background:var(--light-blue);
    border:1px solid #d7e2e8;
    border-radius:4px;
    color:var(--slate);
    font:400 14px/1.7 var(--sans);
  }
  @media(max-width:1050px) {
    .reports-grid {grid-template-columns:repeat(2,minmax(0,1fr))}
    .reports-card {min-height:230px}
  }
  @media(max-width:720px) {
    .reports-hero {padding:80px 0 77px}
    .reports-hero h1 {font-size:clamp(45px,8vw,65px)}
    .reports-content {padding:62px 0 80px}
  }
  @media(max-width:590px) {
    .reports-grid {grid-template-columns:1fr;gap:13px}
    .reports-card {min-height:190px;padding:25px;gap:24px}
    .reports-card h2 {font-size:26px}
    .reports-note {margin-top:18px;padding:18px}
  }
  @media(prefers-reduced-motion:reduce) {
    .reports-card,.reports-card__link span {transition:none}
  }
</style>
