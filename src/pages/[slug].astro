---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import { expertise } from '../data/site';
import { reportCopy } from '../data/reportCopy';

export function getStaticPaths() {
  const locations = [
    { slug: 'glasgow', title: 'Psychiatric expert reports in Glasgow' },
    { slug: 'edinburgh', title: 'Psychiatric expert reports for Edinburgh' }
  ];
  return [...expertise, ...locations].map(item => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

const { item } = Astro.props;
const copy = reportCopy[item.slug];
const locationPage = item.slug === 'glasgow' || item.slug === 'edinburgh';
---
<ContentPageLayout
  title={item.title + ' | Insight Medicolegal'}
  description={copy.intro}
  heading={item.title}
  lead={copy.intro}
  contentClass="report-page"
>
  <div class="report-page__body">
    <h2>{locationPage ? 'Types of cases' : 'What a report can cover'}</h2>
    <ul class="report-page__list">
      {copy.points.map(point => <li>{point}</li>)}
    </ul>
    {copy.note && <p class="report-page__note content-page-note">{copy.note}</p>}
    <a class="button content-page-button--accent" href="/contact">Ask about a report ↗</a>
  </div>
</ContentPageLayout>
