---
import BaseLayout from '../layouts/BaseLayout.astro';
import {expertise,site} from '../data/site';
const locations=[{slug:'glasgow',title:'Psychiatric expert witness Glasgow',summary:'Independent psychiatric reports from Glasgow-based Consultant Psychiatrist Dr Yameen Qureshi.'},{slug:'edinburgh',title:'Psychiatric expert witness Edinburgh',summary:'Independent psychiatric reports for Edinburgh legal and professional instructions.'}];
export function getStaticPaths(){return [...expertise,...locations].map(item=>({params:{slug:item.slug},props:{item}}));}
const {item}=Astro.props;
---
<BaseLayout title={item.title+' | Insight Medicolegal'} description={item.summary}><section class="inner-page"><div class="container"><h1>{item.title}</h1><p class="page-lead">{item.summary}</p><div class="editorial-grid"><div aria-hidden="true"></div><div class="editorial-content"><section class="editorial-section"><h2>Independent psychiatric opinion</h2><p>Expert assessment considers the relevant clinical history, symptoms and evidence within the scope of the proposed instruction.</p></section><section class="editorial-section"><h2>Assessment and reports</h2><p>Diagnosis, causation, treatment and prognosis may be addressed where supported by the evidence. Each instruction is considered individually.</p></section><p>Please provide the questions to be addressed, approximate volume of records and required reporting date.</p><div class="internal-actions"><a class="button button-dark" href="/instructions">Discuss an instruction ↗</a><a href={'mailto:'+site.email}>Email Dr Qureshi ↗</a></div></div></div></div></section></BaseLayout>
