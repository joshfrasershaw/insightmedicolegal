---
import BaseLayout from '../layouts/BaseLayout.astro';
import {site} from '../data/site';
---
<BaseLayout title="Privacy policy | Insight Medicolegal" description="Privacy information for professional medico-legal instructions."><section class="inner-page"><div class="container legal-content"><h1>Privacy policy</h1><p class="page-lead">Insight Medicolegal Ltd is the controller for personal information processed in professional enquiries and medico-legal instructions. Registered in Scotland, SC822243. ICO ZB830807.</p><h2>Contact</h2><p>For data protection enquiries, contact <a href={'mailto:'+site.email}>{site.email}</a>.</p><h2>Confidential records</h2><p>Do not send medical records until secure arrangements have been agreed.</p></div></section></BaseLayout>
