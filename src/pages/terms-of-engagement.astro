---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Terms of engagement | Insight Medicolegal" description="Terms for psychiatric expert reports.">
  <section class="inner-page">
    <div class="container legal-content">
      <h1>Terms of engagement</h1>
      <p class="page-lead">Asking about a report does not mean you've instructed Dr Qureshi.</p>
      <h2>Before work starts</h2>
      <p>Fees, timing and the work involved are agreed before an instruction is accepted.</p>
      <p>Dr Qureshi gives his own independent medical opinion.</p>
      <a class="button button-dark" href="/contact">Ask about a report ↗</a>
    </div>
  </section>
</BaseLayout>
