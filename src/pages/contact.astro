---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Contact | Insight Medicolegal" description="Email or call Dr Yameen Qureshi about a psychiatric expert report.">
  <section class="inner-page">
    <div class="container">
      <header class="page-head">
        <h1>Contact</h1>
        <p class="page-lead">Email or call Dr Qureshi about a report.</p>
      </header>
      <div class="contact-grid">
        <div class="contact-details">
          <div class="contact-detail">
            <h2>Email</h2>
            <a href={'mailto:' + site.email}>{site.email}</a>
          </div>
          <div class="contact-detail">
            <h2>Phone</h2>
            <a href={site.phoneHref}>{site.phone}</a>
          </div>
        </div>
        <div class="contact-note">
          <h2>First enquiry</h2>
          <p>A short outline of the case is enough to get started. Mention a deadline if you have one.</p>
          <p>Don't send medical records until you've agreed a secure way to send them.</p>
          <a class="button button-dark" href={'mailto:' + site.email}>Send an email ↗</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
