---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Accessibility | Insight Medicolegal" description="Help using the Insight Medicolegal website.">
  <section class="inner-page">
    <div class="container legal-content">
      <h1>Accessibility</h1>
      <p class="page-lead">If you have trouble using this website, tell us.</p>
      <p>We can help you find the information you need. Email <a href={'mailto:' + site.email}>{site.email}</a> or call <a href={site.phoneHref}>{site.phone}</a>.</p>
    </div>
  </section>
</BaseLayout>
