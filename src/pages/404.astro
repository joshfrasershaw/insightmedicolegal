---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Insight Medicolegal" description="The page you requested could not be found.">
  <section class="internal-page" aria-labelledby="not-found-title">
    <div class="page-container">
      <h1 id="not-found-title">This page isn't where it should be.</h1>
      <p class="page-lead">The page you're looking for may have moved, or the link may no longer be available.</p>
      <div style="display:flex; flex-wrap:wrap; gap:16px; margin-top:32px;">
        <a class="button button-dark" href="/">Return to homepage ↗</a>
        <a class="button" href="/contact">Contact the practice ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
