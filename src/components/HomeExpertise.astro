---
import ArrowIcon from './ArrowIcon.astro';
import { expertise } from '../data/site';

// Six focused entry points on the homepage. All eight subjects remain available
// through the full expertise index, including chronic pain and personality disorders.
const featuredSlugs = [
  'post-traumatic-stress-disorder',
  'anxiety-depression',
  'addiction-psychiatry',
  'personal-injury-clinical-negligence',
  'employment-occupational-matters',
  'professional-regulation'
];
const featuredReports = featuredSlugs.map(slug => expertise.find(item => item.slug === slug)).filter((item): item is (typeof expertise)[number] => item !== undefined);
---
<section class="section expertise-section" aria-labelledby="expertise-title">
  <div class="container">
    <h2 id="expertise-title">Types of reports</h2>
    <div class="expertise-list">
      {featuredReports.map(item => (
        <a class="expertise-item" href={'/' + item.slug}>
          <div class="expertise-item-copy">
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </div>
          <span class="expertise-arrow" aria-hidden="true"><ArrowIcon /></span>
        </a>
      ))}
    </div>
  </div>
</section>
