---
import { expertise } from '../data/site';
---
<section class="section expertise-section" aria-labelledby="expertise-title">
  <div class="container">
    <h2 id="expertise-title" class="visually-hidden">Types of reports</h2>
    <div class="expertise-list">
      {expertise.map((item, i) => (
        <a class="expertise-item" href={'/' + item.slug}>
          <span class="expertise-number">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <span class="expertise-arrow">Read more ↗</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
