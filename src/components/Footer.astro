---
import { site, mainNav } from '../data/site';
const legalNav = [
  { href: '/privacy-policy', label: 'Privacy policy' },
  { href: '/cookie-policy', label: 'Cookie policy' },
  { href: '/terms-of-engagement', label: 'Terms of engagement' },
  { href: '/accessibility', label: 'Accessibility' },
];
---
<footer class="site-footer site-footer--cloisters" aria-label="Contact and site information">
  <div class="site-footer__inner">
    <section class="site-footer__cta" aria-labelledby="footer-cta-heading">
      <h2 id="footer-cta-heading">Discuss an instruction.</h2>
      <p>For a new instruction, please provide the questions to be addressed, approximate volume of records and your required reporting date.</p>
      <div class="site-footer__actions">
        <a class="button button-light" href={'mailto:' + site.email}>Email Dr Qureshi ↗</a>
        <a class="site-footer__phone" href={site.phoneHref}>Call {site.phone} ↗</a>
      </div>
      <p class="site-footer__confidentiality">Please do not send confidential medical records until secure transfer arrangements have been agreed.</p>
    </section>
    <div class="site-footer__details">
      <a href="/" class="site-footer__wordmark" aria-label="Insight Medicolegal home">INSIGHT <span>MEDICOLEGAL</span></a>
      <p class="site-footer__descriptor">Independent psychiatric expert witness reports by {site.doctor}.</p>
      <div class="site-footer__navigation">
        <nav aria-label="Footer navigation">
          <h3>Explore</h3>
          <a href="/">Home</a>
          {mainNav.map(item => <a href={item.href}>{item.label === 'Expertise' ? 'Areas of expertise' : item.label}</a>)}
          <a href="/glasgow">Glasgow</a>
          <a href="/edinburgh">Edinburgh</a>
        </nav>
        <nav aria-label="Legal links">
          <h3>Information</h3>
          {legalNav.map(item => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
      <p class="site-footer__legal">© {new Date().getFullYear()} {site.legalName} · Registered in Scotland {site.companyNumber}<span class="site-footer__legal-break"> · </span>{site.registeredOffice}<span class="site-footer__legal-break"> · </span>GMC {site.gmc}.</p>
      <p class="site-footer__credit">Website built and managed by <a href={site.developerUrl} rel="noopener noreferrer">{site.developerName}</a>.</p>
    </div>
  </div>
</footer>
