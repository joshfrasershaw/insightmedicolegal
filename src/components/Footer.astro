---
import { site, mainNav } from '../data/site';
const legalNav = [
  { href: '/privacy-policy', label: 'Privacy policy' },
  { href: '/cookie-policy', label: 'Cookie policy' },
  { href: '/terms-of-engagement', label: 'Terms of engagement' },
  { href: '/accessibility', label: 'Accessibility' },
];
---
<footer class="site-footer site-footer--plain" aria-label="Site information">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__wordmark" aria-label="Insight Medicolegal home">INSIGHT <span>MEDICOLEGAL</span></a>
        <p class="site-footer__descriptor">Dr Yameen Qureshi · Consultant psychiatrist, Glasgow.</p>
      </div>
      <nav class="site-footer__pages" aria-label="Footer navigation">
        <h2>Explore</h2>
        <div class="site-footer__links">
          <a href="/">Home</a>
          {mainNav.map(item => <a href={item.href}>{item.label}</a>)}
          <a href="/glasgow">Glasgow</a>
          <a href="/edinburgh">Edinburgh</a>
        </div>
      </nav>
      <nav class="site-footer__policies" aria-label="Legal links">
        <h2>Information</h2>
        <div class="site-footer__links">
          {legalNav.map(item => <a href={item.href}>{item.label}</a>)}
          <button class="site-footer__cookie-settings" type="button" data-cookie-open>Cookie settings</button>
        </div>
      </nav>
    </div>
    <div class="site-footer__bottom">
      <p>© {new Date().getFullYear()} {site.legalName} · Registered in Scotland {site.companyNumber} · GMC {site.gmc} · {site.registeredOffice}</p>
      <p>Website by <a href={site.developerUrl} rel="noopener noreferrer">{site.developerName}</a>.</p>
    </div>
  </div>
</footer>
