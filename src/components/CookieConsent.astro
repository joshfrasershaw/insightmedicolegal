---
/**
 * Website cookie consent UI.
 * Analytics and advertising services are not installed at present.
 * When a service is added: disclose its provider, enable its category, bump
 * CONSENT_VERSION in the controller, and strictly gate the service itself.
 */
---
<aside id="cookie-banner" class="cookie-banner" aria-labelledby="cookie-banner-title" hidden>
  <div class="cookie-banner__copy">
    <h2 id="cookie-banner-title">Cookies and privacy</h2>
    <p>We use essential browser storage to remember your cookie choice. We don't currently use analytics or advertising cookies. <a href="/cookie-policy">Cookie details</a>.</p>
  </div>
  <div class="cookie-banner__actions">
    <button class="cookie-button cookie-button--primary" id="cookie-reject" type="button">OK</button>
    <button class="cookie-button cookie-button--secondary" id="cookie-accept" type="button" hidden>Accept optional</button>
    <button class="cookie-button cookie-button--secondary" id="cookie-manage" type="button">Settings</button>
  </div>
</aside>

<div id="cookie-settings" class="cookie-settings" role="dialog" aria-modal="true" aria-labelledby="cookie-settings-title" aria-describedby="cookie-settings-description" hidden>
  <div class="cookie-settings__panel" tabindex="-1">
    <div class="cookie-settings__top">
      <h2 id="cookie-settings-title">Cookie settings</h2>
      <button class="cookie-settings__close" id="cookie-close" type="button" aria-label="Close cookie settings">✕</button>
    </div>
    <p id="cookie-settings-description">Only essential storage is currently used. You can change your choice at any time using the link in the footer.</p>
    <div class="cookie-settings__categories">
      <div class="cookie-category">
        <div><h3>Necessary</h3><p>Remembers your cookie settings and supports basic site security.</p></div>
        <strong class="cookie-category__status">Always on</strong>
      </div>
      <div class="cookie-category">
        <div><h3>Analytics</h3><p>Would help us understand website use. No analytics tools are installed today.</p></div>
        <label class="cookie-category__switch">
          <span class="sr-only">Allow analytics cookies</span>
          <input id="cookie-analytics" type="checkbox" disabled />
          <span class="cookie-category__status">Not in use</span>
        </label>
      </div>
      <div class="cookie-category">
        <div><h3>Advertising</h3><p>Would be used to measure or tailor advertising. No advertising trackers are installed today.</p></div>
        <label class="cookie-category__switch">
          <span class="sr-only">Allow advertising cookies</span>
          <input id="cookie-advertising" type="checkbox" disabled />
          <span class="cookie-category__status">Not in use</span>
        </label>
      </div>
    </div>
    <p class="cookie-settings__note">We won't treat your choice as consent for any services added later. New tracking tools would require a new notice and a fresh choice.</p>
    <div class="cookie-settings__actions">
      <button class="cookie-button cookie-button--secondary" type="button" id="cookie-settings-reject">Necessary only</button>
      <button class="cookie-button cookie-button--primary" type="button" id="cookie-save">Save settings</button>
      <button class="cookie-button cookie-button--secondary" type="button" id="cookie-settings-accept" hidden>Accept optional</button>
    </div>
  </div>
</div>
<script>import '../scripts/cookie-consent';</script>
