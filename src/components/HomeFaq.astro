---
import FAQ from './FAQ.astro';
const questions = [
  {
    question: 'Can assessments be conducted remotely?',
    answer: 'Psychiatric assessments can be undertaken in person or remotely, depending on the individual circumstances and clinical requirements of each case.'
  },
  {
    question: 'What information is required for an initial enquiry?',
    answer: 'An initial enquiry outlining the nature of the case, the scope of the proposed instruction and any deadlines is usually sufficient. Arrangements can then be made for the secure transfer of medical records and supporting documentation.'
  },
  {
    question: 'What are your fees?',
    answer: 'Fees depend on the nature and complexity of the instruction. Please provide an approximate page count of the documents to be reviewed when requesting a quotation.'
  },
  {
    question: 'What are your reporting timescales?',
    answer: 'Reports are typically completed within two to four weeks of the psychiatric assessment, with a confirmed reporting deadline agreed at the point of instruction. Urgent instructions can be considered.'
  },
  {
    question: 'Can members of the public instruct you directly or seek clinical advice?',
    answer: 'Insight Medicolegal provides independent psychiatric expert opinions to solicitors, insurers and other professional organisations. Instructions are not accepted directly from members of the public, and the service does not offer psychiatric consultations or treatment to individuals seeking clinical care.'
  }
];
---
<section class="section faq-section" aria-labelledby="faq-heading">
  <div class="container faq-grid">
    <div class="faq-intro">
      <h2 id="faq-heading">Questions</h2>
      <p>Practical information for solicitors and other professionals considering an instruction.</p>
    </div>
    <FAQ questions={questions} />
  </div>
</section>
